{
  "name": "@morewax/dsh-remote-exec",
  "description": "Run DeepSeek Harness locally, execute on your server \u2014 ssh / mosh / sam transports with remote file and shell tools",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-remote-exec.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/invariant.d.mts",
      "default": "./lib/invariant.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/invariant.mjs",
    "cordis.patch.yml",
    "lib/*.d.mts",
    "lib/*.d.mts.map"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/invariant.ts --format esm --dts --out-dir lib",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@types/node": "^22",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
