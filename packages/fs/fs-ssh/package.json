{
  "name": "@morewax/dsh-fs-ssh",
  "description": "Remote execution provider family for DeepSeek Harness \u2014 SSH/MOSH drivers, remote filesystem and shell",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-remote-exec.git",
    "directory": "packages/fs/fs-ssh"
  },
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.mts",
      "default": "./lib/invariant.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/invariant.mjs",
    "lib/types/**/*.d.mts"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/invariant.ts --format esm --dts --out-dir lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@deepseek-ai/cosmokit": ">=1.8.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@morewax/dsh-remote-transport": ">=0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@morewax/dsh-remote-transport": "workspace:*",
    "@morewax/dsh-transport-ssh": "workspace:*"
  }
}
