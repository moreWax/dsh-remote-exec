{
  "name": "@morewax/dsh-transport-sam",
  "description": "SAM mesh transport provider: remote exec/files via sam-node MCP with zero local keys",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-remote-exec.git",
    "directory": "packages/remote/transport-sam"
  },
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/types/**/*.d.mts"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@morewax/dsh-remote-transport": ">=0.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@morewax/dsh-remote-transport": "workspace:*"
  }
}
